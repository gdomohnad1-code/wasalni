{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nmtlayfaqeaonsawmkbx.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "wasalny-mcp",
      "version": "0.1.0",
      "title": "Wasalny MCP"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in user's profile: full name, phone, wallet balance, referral code, and rating.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_rides",
        "title": "List my rides",
        "description": "List the signed-in user's recent rides (as rider) with pickup, destination, price, and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max number of rides to return (default 10)."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter, e.g. 'completed', 'cancelled', 'in_progress'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "file_complaint",
        "title": "File a complaint",
        "description": "Submit a support complaint on behalf of the signed-in user. Returns the created complaint id.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120,
              "description": "Short subject line."
            },
            "message": {
              "type": "string",
              "minLength": 5,
              "maxLength": 4000,
              "description": "Full complaint details."
            },
            "category": {
              "type": "string",
              "description": "Category, e.g. 'general', 'driver', 'payment'. Defaults to 'general'."
            },
            "ride_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional related ride id."
            }
          },
          "required": [
            "subject",
            "message"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
